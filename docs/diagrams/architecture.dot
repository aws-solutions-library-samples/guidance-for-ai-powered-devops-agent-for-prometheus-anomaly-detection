digraph amp {
  rankdir=LR; bgcolor="white"; pad=0.3; nodesep=0.4; ranksep=0.9;
  graph [fontname="Helvetica", label=<<B>AI-Powered DevOps Agent for Prometheus — open5gs + Amazon Managed Prometheus</B><BR/><FONT POINT-SIZE="11" COLOR="#5b6b7a">register-only capability provider · no Agent Space created</FONT>>, labelloc=t];
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", penwidth=1.3, margin="0.14,0.09"];
  edge [fontname="Helvetica", fontsize=9, color="#5b6b7a"];

  subgraph cluster_eks {
    label=<<B>Amazon EKS · open5gs-amp-cluster</B>>; style="rounded,filled"; fillcolor="#eef5fb"; color="#2b86c5";
    core [label=<open5gs 5G core+RAN<BR/><FONT POINT-SIZE="9">AMF·SMF·UPF·… + gNB/UEs</FONT>>, fillcolor="#d6efe0"];
    promagent [label=<Prometheus agent / ADOT<BR/><FONT POINT-SIZE="9">scrape /metrics · remote_write (SigV4, IRSA)</FONT>>, fillcolor="#d6e7f5"];
    core -> promagent [label="scrape"];
  }

  amp [label=<Amazon Managed Prometheus<BR/><FONT POINT-SIZE="9">AMP workspace (CDK) · PromQL</FONT>>, shape=cylinder, fillcolor="#ffe8cc", color="#d9822b"];
  promagent -> amp [label="remote_write\n(SigV4)", color="#d9822b", penwidth=1.6];

  subgraph cluster_mcp {
    label=<<B>Prometheus MCP (CDK · from aws-samples)</B>>; style="rounded,filled"; fillcolor="#fff8e6"; color="#b8902a";
    cog [label=<Cognito<BR/><FONT POINT-SIZE="9">M2M OAuth2 client</FONT>>, fillcolor="#f6ebd2"];
    apigw [label=<API Gateway<BR/><FONT POINT-SIZE="9">/mcp (JWT) · /health</FONT>>, fillcolor="#f6ebd2"];
    lam [label=<Prometheus MCP Lambda<BR/><FONT POINT-SIZE="9">5 tools · aps:QueryMetrics…</FONT>>, fillcolor="#f6ebd2"];
    apigw -> lam; cog -> apigw [style=dashed, label="JWT authz"];
  }
  lam -> amp [label="PromQL query", color="#d9822b"];

  agent [label=<AWS DevOps Agent<BR/><FONT POINT-SIZE="9">capability provider (OAuth2)</FONT>>, fillcolor="#e9e0ff", color="#7a5fb0"];
  agent -> cog [label="1 · OAuth2 token", color="#7a5fb0"];
  agent -> apigw [label="2 · MCP + JWT", color="#7a5fb0", penwidth=1.6];

  conncdk [label=<agent-connectivity (CDK)<BR/><FONT POINT-SIZE="9">register-service · NO create-agent-space</FONT>>, shape=note, fillcolor="#fdecec", color="#c0392b"];
  conncdk -> agent [style=dotted, label="registers MCP", color="#c0392b"];

  // ── Automated RCA pipeline (scenario 2b): RCF alert → SNS → RCA Lambda → DevOps Agent webhook ──
  subgraph cluster_rca {
    label=<<B>Automated RCA pipeline (CDK · scenario 2b)</B>>; style="rounded,filled"; fillcolor="#fdecf4"; color="#b0327a";
    rcf [label=<RCF anomaly detector<BR/><FONT POINT-SIZE="9">score on sum(registeredsubnbr) &gt; 0.1</FONT>>, fillcolor="#f6d9ea"];
    almgr [label=<Alertmanager → SNS<BR/><FONT POINT-SIZE="9">RCF5GRegistrationDrop</FONT>>, fillcolor="#f6d9ea"];
    rca [label=<RCA Lambda (open5gs-rcf-rca)<BR/><FONT POINT-SIZE="9">queries AMP · names culprit AMF</FONT>>, fillcolor="#f6d9ea"];
    sm [label=<Secrets Manager<BR/><FONT POINT-SIZE="9">agent webhook url + token</FONT>>, shape=note, fillcolor="#f6ebd2"];
    rcf -> almgr [label="alert"]; almgr -> rca [label="SNS"]; sm -> rca [style=dashed, label="webhook creds"];
  }
  amp -> rcf [label="evaluate (30s)", color="#b0327a"];
  rca -> amp [label="PromQL (per-AMF)", color="#d9822b"];
  rca -> agent [label="POST incident (webhook)", color="#b0327a", penwidth=1.6];
}
